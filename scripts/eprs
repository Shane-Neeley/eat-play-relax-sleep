#!/usr/bin/env bash
set -euo pipefail
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$PROJECT_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
EPRS_PYTHON=""
if [[ -n "${VIRTUAL_ENV:-}" && -x "$VIRTUAL_ENV/bin/python" ]] &&
  "$VIRTUAL_ENV/bin/python" -c 'import sys; raise SystemExit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
  EPRS_PYTHON="$VIRTUAL_ENV/bin/python"
fi
for candidate in python3.14 python3.13 python3.12 python3.11 python3; do
  [[ -z "$EPRS_PYTHON" ]] || break
  if command -v "$candidate" >/dev/null 2>&1 &&
    "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
    EPRS_PYTHON="$(command -v "$candidate")"
    break
  fi
done
if [[ -z "$EPRS_PYTHON" ]]; then
  echo "EPRS requires Python 3.11+ (no supported python3 interpreter found)" >&2
  exit 127
fi
exec "$EPRS_PYTHON" -m eprs.cli "$@"
